{
  "name": "specter",
  "version": "0.1.0",
  "private": true,
  "description": "Specter: situation advice from three personas, spoken with deliberate pauses.",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "dev": "next dev",
    "dev:mock": "cross-env MOCK_AI=1 next dev",
    "build": "next build",
    "start": "next start",
    "start:mock": "cross-env MOCK_AI=1 next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:all": "npm run typecheck && npm test && npm run build && npm run test:e2e",
    "harness": "tsx harness/run.ts",
    "harness:mock": "tsx harness/run.ts --mock",
    "icons": "node scripts/generate-icons.mjs"
  },
  "dependencies": {
    "@deepgram/sdk": "^5.16.0",
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@google/genai": "^2.31.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.118.0",
    "geist": "^1.8.2",
    "next": "^15.5.28",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "cross-env": "^10.1.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.28",
    "postcss": "^8.5.31",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vitest": "^3.2.7"
  }
}
